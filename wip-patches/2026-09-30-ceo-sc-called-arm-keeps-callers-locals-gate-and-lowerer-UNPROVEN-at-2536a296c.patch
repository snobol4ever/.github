+#!/usr/bin/env bash
+# test_gate_sc_a_condition_with_a_called_arm_keeps_the_callers_locals.sh -- A SNOCONE FUNCTION GIVES ITS CALLER BACK EVERY
+# VARIABLE IT SAVED, ON THE FAILING AND ON THE SUCCEEDING EXIT OF A CONDITION, AS ITS OWN TRANSPILE DOES (the ceo's order of
+# 2026-09-29 to cure the Snocone-frontend hang found by the parser_raku.sc rewrite: the chain compiled directly as .sc spun on
+# any second statement, while scrip --transpile of the same chain ran on SCRIP and on SPITBOL).
+#
+# THE BRACKET: scrip --trace dies at the first return of any Snocone function (the traced call site enters the proc without the
+# signature blob its epilogue reads -- a separate defect), so the bracket came from instrumenting the chain on "1;2;": in
+# RkBuildStmtsBk the loop index i read 2 before RkbStatement(...) and 1 after it, and cutting RkbStatement short moved the
+# change to its line "if ((EQ(ls_nitem(L), 0), EQ(ls_n(L), 0))) { return; }" -- a failing two-arm condition whose first arm
+# calls a function. The loop never reached its end.
+# DEFECT 1, THE FRAME (src/templates/xa/xa_flat.cpp): a Snocone function's prologue carved its frame (kt bytes) and THEN the
+# save area for its formals, locals and name (16 bytes each), so rsp sat 16n bytes below the frame the body addresses from rsp:
+# every frame cell of the body landed 16n bytes low, the first arm's cells on the saved words, and the return put an arm's
+# value (the 0 of EQ(G(a), 0)) back into the caller's variable. CURE: the save area is carved ABOVE the frame, at [kt, kt+16n),
+# so rsp is the frame base the body was laid out for; the epilogue restores from there and releases kt+16n.
+# DEFECT 2, THE LOWERING (src/lower/lower_snobol4.c): a condition of if/while/until/do/for that succeeds leaves its value on the
+# stack (the disjunction's 32-byte carve) and its branch ran on top of it; a return in the branch left with the stack 32 bytes
+# off and the epilogue restored and jumped through the wrong words (SIGSEGV). The transpile ends the condition as a statement of
+# its own ("C :F(Lelse)"). CURE: the condition's success continuation, and every return, freturn and nreturn, passes through a
+# STATEMENT_END, as the transpiled statement does.
+#
+# ARM 1 (defect 1): F(a, i) with "if ((EQ(G(a), 0), EQ(a, 0))) { return; }", the condition failing, called with the caller's
+# i = 1 then 2, prints the caller's i unchanged. ARM 2 (defect 2): F with "if ((EQ(G(a), 0), EQ(a, 1))) { return; }" called
+# with a = 0 (the first arm succeeds and returns), a = 1 (the second arm), a = 5 (neither). Each arm's ref is cut at run time by
+# sbl -bf from scrip --transpile of the witness, and each arm runs in mode 3 and in mode 4 (compile, link, run).
+# FAIL-ONCE (SCRIP_BIN=<another tree's scrip>, with LD_LIBRARY_PATH at its out/): on origin 2536a296c arm 1 prints i=0 i=0 and
+# arm 2 dies SIGSEGV, in both modes.
+# rc 0 GREEN · 1 RED (named) · 2 REFUSE (cannot measure).
+"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/util_require_fresh.sh" --gate "$(basename "${BASH_SOURCE[0]}" .sh)" || exit $?
+set -uo pipefail
+G="$(basename "${BASH_SOURCE[0]}" .sh)"
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; ROOT="$(cd "$HERE/.." && pwd)"
+SCRIP="${SCRIP_BIN:-$ROOT/scrip}"; [ -x "$SCRIP" ] || { echo "⛔ GATE REFUSE(2) [$G]: no scrip at $SCRIP"; exit 2; }
+TREE="$(cd "$(dirname "$SCRIP")" && pwd)"; LIBDIR="$TREE/out"; [ -f "$LIBDIR/libscrip_rt.so" ] || { echo "⛔ GATE REFUSE(2) [$G]: no libscrip_rt.so in $LIBDIR"; exit 2; }
+. "$HERE/lib_oracle_flags.sh"
+SBL="$(sbl_correctness_bin)"; [ -x "$SBL" ] || { echo "⛔ GATE REFUSE(2) [$G]: no correctness oracle ($SBL) -- the refs are cut from the oracle at run time, never typed"; exit 2; }
+T=$(mktemp -d) || exit 2; trap 'rm -rf "$T"' EXIT
+ulimit -c 0
+cat > "$T/fails.sc" <<'SC'
+function G(x) { G = x; return; }
+function F(a, i) {
+    if ((EQ(G(a), 0), EQ(a, 0))) { return; }
+    F = ; return;
+}
+i = 1; F(5); OUTPUT = 'i=' i;
+i = 2; F(5); OUTPUT = 'i=' i;
+SC
+cat > "$T/returns.sc" <<'SC'
+function G(x) { G = x; return; }
+function F(a, i) {
+    if ((EQ(G(a), 0), EQ(a, 1))) { return; }
+    F = ; return;
+}
+i = 1; F(0); OUTPUT = 'i=' i;
+i = 2; F(1); OUTPUT = 'i=' i;
+i = 3; F(5); OUTPUT = 'i=' i;
+SC
+RC=0
+for w in fails returns; do
+    ( cd "$T" && timeout 30 "$SCRIP" --transpile "$w.sc" > "$w.sno" 2> "$w.tr.err" ) && [ -s "$T/$w.sno" ] || { echo "⛔ GATE REFUSE(2) [$G]: scrip --transpile of the $w witness failed"; exit 2; }
+    ( cd "$T" && timeout 30 "$SBL" $(sbl_lang_flags) "$w.sno" < /dev/null > "$w.ref" 2> /dev/null )
+    [ -s "$T/$w.ref" ] || { echo "⛔ GATE REFUSE(2) [$G]: the oracle printed nothing for the $w witness's transpile"; exit 2; }
+    red=""
+    ( cd "$T" && timeout 30 "$SCRIP" "$w.sc" < /dev/null > "$w.m3" 2> "$w.m3.err" ); r3=$?
+    cmp -s "$T/$w.m3" "$T/$w.ref" && [ "$r3" = 0 ] || red="$red m3(rc=$r3: $(head -c 60 "$T/$w.m3" | tr '\n' ' ')$(head -c 60 "$T/$w.m3.err" | tr '\n' ' '))"
+    ( cd "$T" && timeout 60 "$SCRIP" --compile -o "$w.s" "$w.sc" < /dev/null > /dev/null 2> "$w.c4.err" ); rc4=$?
+    if [ "$rc4" = 0 ] && ( cd "$T" && gcc "$w.s" -o "$w.bin" -L"$LIBDIR" -lscrip_rt -lm -lpthread -Wl,-rpath,"$LIBDIR" 2> /dev/null ); then
+        ( cd "$T" && timeout 30 "./$w.bin" < /dev/null > "$w.m4" 2> "$w.m4.err" ); r4=$?
+        cmp -s "$T/$w.m4" "$T/$w.ref" && [ "$r4" = 0 ] || red="$red m4(rc=$r4: $(head -c 60 "$T/$w.m4" | tr '\n' ' ')$(head -c 60 "$T/$w.m4.err" | tr '\n' ' '))"
+    else red="$red m4-compile(rc=$rc4 $(head -c 90 "$T/$w.c4.err" | tr '\n' ' '))"; fi
+    if [ -z "$red" ]; then echo "  arm $w PASS: prints '$(tr '\n' ' ' < "$T/$w.ref")' like sbl -bf on its transpile, in mode 3 and mode 4"
+    else echo "  arm $w RED:$red -- the oracle prints '$(tr '\n' ' ' < "$T/$w.ref")'"; RC=1; fi
+done
+if [ "$RC" = 0 ]; then echo "GATE PASS(0) [$G]: a Snocone function gives its caller back every saved variable on both exits of a condition with a called arm (2 arms x 2 modes)"
+else echo "GATE FAIL(1) [$G]: a Snocone function hands its caller a wrong variable or a broken stack after a condition with a called arm (2 arms x 2 modes)"; fi
+echo "    tree: SCRIP=$(git -C "$TREE" rev-parse --short HEAD 2>/dev/null)$(git -C "$TREE" diff --quiet 2>/dev/null || echo -DIRTY)  measured $(date -u +%Y-%m-%dT%H:%MZ)"
+exit $RC
