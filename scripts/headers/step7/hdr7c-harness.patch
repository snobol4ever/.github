+        units = []
+        for line in r.stdout.splitlines():
+            if ' -c ' not in line:
+                continue
+            toks = shlex.split(line)
+            if toks and toks[0] == 'ccache':
+                toks = toks[1:]
+            if '-c' not in toks:
+                continue
+            src = toks[toks.index('-c') + 1]
+            flags, i = [], 1
+            while i < len(toks):
