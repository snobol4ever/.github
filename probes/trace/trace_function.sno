	&TRACE = 100
	DEFINE('F(X)')
	DEFINE('G(Y)')
	DEFINE('H(Z)')
	DEFINE('W(A,B)')	:(START)
F	F = G(X) + 1	:(RETURN)
G	G = Y * 2	:(RETURN)
H	H = .M	:(NRETURN)
W		:(FRETURN)
START	TRACE('F', 'CALL')
	TRACE('F', 'RETURN')
	TRACE('G', 'FUNCTION')
	TRACE('H', 'F')
	TRACE('W', 'C')
	OUTPUT = F(3)
	H() = 7
	W('s', 1.5)	:F(NEXT)
NEXT	OUTPUT = 'done ' M
END
