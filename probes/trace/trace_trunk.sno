	&TRACE = 100
	DEFINE('TF(NAME,TAG)')
	DEFINE('F(X)')	:(START)
TF	OUTPUT = 'tf ' TAG ' ' NAME ' = ' $NAME ' lastno=' &LASTNO ' trace=' &TRACE	:(RETURN)
F	F = X	:(RETURN)
START	TRACE('N', 'VALUE', 'tagN', .TF)
	TRACE('F', 'CALL', 'tagF', .TF)
	TRACE('F', 'RETURN', 'tagR', .TF)
	TRACE('M', 'V')
	TRACE('P')
	N = 1
	N = F(2)
	M = 3
	P = 4
	STOPTR('M', 'VALUE')
	STOPTR('P')
	M = 5
	P = 6
	OUTPUT = 'done ' N ' ' M ' ' P ' trace=' &TRACE
END
